# Google Sheets Webhook URL for Consultation Form Integration
# Deploy your Google Apps Script as a Web App (Anyone access) and paste the URL here.
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID_HERE/exec

# Telegram Instant Bot Notification Alert (Optional)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyZ
TELEGRAM_CHAT_ID=-1001234567890

# WhatsApp Contact Number for Direct Chat Link (e.g. 628131600130)
NEXT_PUBLIC_WHATSAPP_NUMBER=628131600130

# Target Email Notification Alert Recipients
NOTIFICATION_EMAIL=amang.udinjundi@gmail.com,aloysius.adrian@radyalabs.com

# Twilio WhatsApp API Configuration (Optional for instant WA alert to admin)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_TARGET_WHATSAPP_NUMBER=whatsapp:+628131600130

# ==========================================
# Studio Blog Editor (tim media)
# ==========================================
# GUI di /studio/login untuk membuat artikel content/posts/*.md.
# Ganti dengan password kuat & rahasiakan. Jangan commit .env.local.
BLOG_ADMIN_PASSWORD=ganti-dengan-password-kuat
# Secret HMAC sesi login (opsional; default memakai BLOG_ADMIN_PASSWORD).
# STUDIO_SESSION_SECRET=isi-string-acak-panjang-minimal-32-karakter

# ==========================================
# Studio AI (Create with AI di /studio/blog/create)
# ==========================================
# Provider: "gemini" (default, ada free tier) atau "openai" (endpoint
# kompatibel OpenAI: OpenAI / Groq / OpenRouter / DeepSeek).
STUDIO_AI_PROVIDER=gemini
# Google Gemini API key: gratis via Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
STUDIO_AI_API_KEY=your_gemini_api_key_here
# Model default Gemini: gemini-3.5-flash-lite atau gemini-3.5-flash
STUDIO_AI_MODEL=gemini-3.5-flash-lite
# Khusus provider openai — contoh:
# Groq (gratis & cepat):  base=https://api.groq.com/openai/v1, model=llama-3.3-70b-versatile
# OpenRouter (ada model gratis): base=https://openrouter.ai/api/v1, model=deepseek/deepseek-chat-v3-0324:free
# DeepSeek resmi (sangat murah): base=https://api.deepseek.com/v1, model=deepseek-chat
# OpenAI: base=https://api.openai.com/v1, model=gpt-4o-mini
# STUDIO_AI_BASE_URL=https://api.groq.com/openai/v1

# ==========================================
# AI Image Generation (aotianzz.xyz / NewAPI)
# ==========================================
IMAGE_AI_API_KEY=sk-uqIUPuBrG9KFFioltLjqASn7Vphfp8y3ZdpfDt0zfDJaGPnQ
IMAGE_AI_BASE_URL=https://aotianzz.xyz
IMAGE_AI_DEFAULT_MODEL=gpt-image-2.5-sunburst-4k

# ==========================================
# Analytics & Tracking Integrations
# ==========================================
# Google Tag Manager (GTM) Container ID
NEXT_PUBLIC_GTM_ID=GTM-5GQVZ7X2

# Contentsquare / Hotjar Unified Tag ID (e.g. 3cf6b9ab41531)
NEXT_PUBLIC_CONTENTSQUARE_TAG_ID=3cf6b9ab41531
